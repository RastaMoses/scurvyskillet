[node name="choice2" parent="Choices" parent_id_path=PackedInt32Array(504841176) index="1" unique_id=669889480]
title = "GREAT CATCH"
description = "Surprisingly you catch both sweet- and saltwater fish here, all of them fat and barely putting up a fight."
