[node name="text" parent="description" parent_id_path=PackedInt32Array(747135996) index="1" unique_id=670048361]
text = "You cross by a dark cavern looming under an islands cliff surrounded hard to navigate rock formations. There is a lot of life in the safety of the cove, a pretty good place to catch more ingredients. Glancing over the cave mouth a glimmer catches your eye and a faint waft of something sweet is on the air...

"

[node name="title" parent="description" parent_id_path=PackedInt32Array(747135996) index="2" unique_id=1975928171]
text = "MYSTICAL COVE"

[node name="choice1" parent="Choices" parent_id_path=PackedInt32Array(504841176) index="0" unique_id=704699521]
title = "CRYSTAL CAVE"
description = "As you navigate your vessel closer to the rock opening, the darkness within is cut by bright reflections of white crystals zig-zagging along the cave mouth. You surpress your amazement enough to ready the small off-ship expedition."
button_text = "Move Closer"
