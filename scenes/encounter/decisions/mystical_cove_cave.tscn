[node name="choice3" parent="Choices" parent_id_path=PackedInt32Array(504841176) index="2" unique_id=474290282]
title = "COOK FOR THE CREATURE"
description = "It seems the best approach should be to introduce yourselves with a present.
Something Sweet and Fishy ought to make them happy, you put on your apron and do your thing"
button_text = "WOO THEM WITH A DISH"
