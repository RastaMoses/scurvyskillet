success_title = "OGRE HAPPY"
success_description = "With your present in hand you return to the ogre. It jumps up and points at the dish grunting: \"Buy!\" What happens next is too fast for you to intervene. The ogre throws a bunch of coins in your general direction before swiping the food out of your hands. After watching them gobble it down, they offer you to buy from them, throwing in some freebies for the great meal."
success_money = 5
s_next_encounter = ExtResource("2_304c0")
s_random_ingredient_amount = 2
s_and_req = true
s_req_rarity = Array[int]([0, 1, 2])
s_req_tag = Array[int]([14])
partial_description = "The ogre has not noticed the dish you had lain out in front of them. After approaching it again it grunts: \"No buy - You buy.\" Pointing first at your unimpressive dish, then at its own stock of paper bundles."
p_next_encounter = ExtResource("2_304c0")
failure_title = "YOU NO BUY"
failure_description = "Upon entering the cave again with your preperations and slowly laying it on the groud in view of the ogre, it immediatly stops what it's doing. A stern look engraves itself on their bulbous visage, as if you had just insulted their whole kin. \"YOU NO BUY\" comes from the slowly rising figure. You understand, this is the time to leave before it gets more dangerously angry."

